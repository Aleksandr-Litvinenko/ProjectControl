{
  "name": "projectcontrol",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectControl — рабочее место проектного офиса (портфель проектов, чек-листы, сроки, загрузка специалистов).",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "audit:routes": "node tools/audit-routes.mjs --markdown docs/ACCESS-MAP.md",
    "audit:routes:check": "node tools/audit-routes.mjs --quiet"
  },
  "engines": {
    "node": ">=20"
  }
}
