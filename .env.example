# ===========================================================================
# ProjectControl — пример переменных окружения.
# Скопируй в .env (НЕ коммить .env) и подставь реальные значения.
# Секреты генерируй: openssl rand -hex 32
# ===========================================================================

# --- PostgreSQL (контейнер db) ---
POSTGRES_USER=projectcontrol
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=projectcontrol

# Строка подключения для API.
# В Docker-сети хост БД = "db". Для локального psql замените на localhost:5433.
DATABASE_URL=postgresql://projectcontrol:CHANGE_ME_strong_password@db:5432/projectcontrol?schema=public

# --- API ---
NODE_ENV=production
API_PORT=4000
# Секрет подписи JWT в httpOnly-cookie (openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_64_hex_chars
# Уникальные пароли только для локальных/изолированных seed-данных.
# Не используйте эти значения в публичном demo или production.
SEED_ADMIN_PASSWORD=CHANGE_ME_unique_admin_password
SEED_DEMO_PASSWORD=CHANGE_ME_unique_demo_password
# Время жизни сессии (в днях)
SESSION_TTL_DAYS=7
# Secure-cookie только по HTTPS (true на проде)
COOKIE_SECURE=true
# Домен cookie (пусто = текущий хост)
COOKIE_DOMAIN=

# --- Файлы ---
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=25

# --- Публичный домен / фронт ---
PUBLIC_DOMAIN=projectcrm.ru
# База API для фронта (тот же origin → /api)
VITE_API_BASE=/api

# --- Пороги индикатора здоровья (необязательные оверрайды) ---
HEALTH_DEADLINE_SOON_DAYS=7
HEALTH_OVERLOAD_YELLOW_PCT=100
HEALTH_OVERLOAD_RED_PCT=120
